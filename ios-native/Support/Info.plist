<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- « Ouvrir dans Carnet Malin »: the kinds of document the app accepts from Mail, Safari, Fichiers and iCloud Drive.
	     Alternate, not Owner: the app knows how to open these files, it does not claim them. The rest of the Info.plist
	     is generated from the build settings. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Livre EPUB</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.idpf.epub-container</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.jpeg</string>
				<string>public.png</string>
				<string>public.heic</string>
			</array>
		</dict>
	</array>
	<!-- The family's server. Filled from CARNET_SERVER_URL (Support/Server.xcconfig, never versioned): the
	     address of a private server does not belong in a public repository. Empty in a fresh clone, and the app
	     then asks for the address as it used to, which is also how a developer points it at their own machine. -->
	<key>CarnetServerURL</key>
	<string>$(CARNET_SERVER_URL)</string>
	<!-- The reading fonts, in CarnetMalin/Fonts with their SIL Open Font Licence. The folder is synchronised, so its
	     files land at the root of the bundle and are listed here by file name alone. Bold comes from its own file
	     rather than being drawn thicker by the system. -->
	<key>UIAppFonts</key>
	<array>
		<string>Lexend-Regular.ttf</string>
		<string>Lexend-Bold.ttf</string>
		<string>Andika-Regular.ttf</string>
		<string>Andika-Bold.ttf</string>
		<string>AtkinsonHyperlegible-Regular.ttf</string>
		<string>AtkinsonHyperlegible-Bold.ttf</string>
		<string>OpenDyslexic-Regular.otf</string>
		<string>OpenDyslexic-Bold.otf</string>
	</array>
	<!-- iOS hands over a copy in Documents/Inbox; the app imports it and deletes the copy. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<!-- A family's server may live on their own network, with a name like « carnet.local » and no certificate a
	     phone would trust; a developer's runs on their own machine while they work. This says « local addresses
	     only », which is the narrow exception Apple asks for and reviews without a justification. Everything
	     leaving the house still has to be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
