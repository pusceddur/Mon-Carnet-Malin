<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ce que l'app fait des données, déclaré à Apple. Sans ce fichier, l'envoi sur App Store Connect
	     répond ITMS-91053 « Missing API declaration » pour les API ci-dessous.

	     L'app ne suit personne et ne parle à aucun service tiers : elle ne parle qu'au serveur de la
	     famille, dont l'adresse est saisie par l'adulte. -->

	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- Données envoyées au serveur de la famille, pour faire fonctionner l'app et rien d'autre :
	     jamais de publicité, jamais de suivi, jamais revendues. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- L'adresse e-mail du compte de l'adulte : c'est l'identifiant de connexion. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Le prénom que l'adulte se donne dans son compte. Les lecteurs, eux, n'ont qu'un surnom
			     choisi librement, qui compte comme contenu et non comme identité. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Les livres importés, les pages photographiées, les notes, les devoirs et les réponses :
			     tout ce que la famille met dans l'app, synchronisé entre ses appareils. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Les pannes techniques de l'appareil (PDF illisible, mémoire, OCR qui échoue).
			     Jamais le texte d'une page, jamais le nom d'un fichier. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>

	<!-- API à motivation obligatoire réellement utilisées par l'app. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- Date de modification des fichiers, uniquement dans le conteneur de l'app :
			     la mémoire des réponses de l'aide garde ses fichiers un mois (AICache). -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<!-- Espace libre sur l'appareil : « Tester la lecture sur cet appareil » le montre à l'adulte,
			     et l'import s'en sert pour ne pas commencer un scan qui ne tiendra pas. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
