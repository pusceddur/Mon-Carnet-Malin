# Copy to server/.env (development) or set these in the hosting control panel (production).
# Never commit real values.

# development | production | test
NODE_ENV=development
# HTTP port (some hosts provide PORT or a socket path in production)
PORT=3001
# debug | info | warn | error | silent
LOG_LEVEL=info

# Production: mysql://user:password@host:3306/database (required)
# Development default: sqlite:./data/dev.sqlite  (tests: sqlite::memory:)
DATABASE_URL=

# One-time token required by POST /api/auth/setup (first parent account)
SETUP_TOKEN=
# Optional extra secret (reserved for session hardening)
SESSION_SECRET=

# AI providers per tier: plugin | openai | worker | local | mock
# AI_PROVIDER sets both tiers; AI_PROVIDER_LIGHT / AI_PROVIDER_COMPLEX override per tier.
# Default: plugin if AI_PLUGIN_PATH is set, otherwise openai if OPENAI_BASE_URL is set, otherwise worker if
# WORKER_TOKEN_SHA256 is set, otherwise local (no external AI).
AI_PROVIDER=
AI_PROVIDER_LIGHT=
AI_PROVIDER_COMPLEX=
# Second AI, used when the first cannot answer (down, over its limit, too slow). Empty = none.
# AI 1 = LM Studio, AI 2 = the home computer:  AI_PROVIDER=openai  AI_FALLBACK=worker
# Turn one off: leave AI_FALLBACK empty (AI 1 only) or set AI_PROVIDER=worker (AI 2 only); AI_PROVIDER=local = no AI.
AI_FALLBACK=
AI_FALLBACK_LIGHT=
AI_FALLBACK_COMPLEX=

# OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp, OpenAI…). Base URL up to /v1:
#   LM Studio  http://localhost:1234/v1     Ollama  http://localhost:11434/v1     OpenAI  https://api.openai.com/v1
OPENAI_BASE_URL=
# Empty for a local server.
OPENAI_API_KEY=
# Model id as the server lists it (GET /v1/models). OPENAI_MODEL_LIGHT / _COMPLEX override per tier;
# a tier without a model is not served by this provider.
OPENAI_MODEL=
OPENAI_MODEL_LIGHT=
OPENAI_MODEL_COMPLEX=
# json_schema (default) | json_object | prompt — lower it if the server rejects response_format.
OPENAI_JSON_MODE=
# The model reads images (handwritten answers). false = those requests go to the fallback.
OPENAI_IMAGES=
# Longest wait for one answer in ms (default 40000 light, 170000 complex); keep it short with a fallback.
OPENAI_TIMEOUT_MS=
# € per million tokens, only for a paid service: counted in the parents' monthly budget. Empty = free.
OPENAI_PRICE_INPUT=
OPENAI_PRICE_OUTPUT=
# Names the model could use for itself (comma separated), on top of the model ids.
OPENAI_SELF_REFERENCE_TERMS=
# Path of the external provider module (not part of this repository). Its own settings are documented privately.
AI_PLUGIN_PATH=

# External worker (outbound connection from a separate computer, bearer token).
# Hex sha256 of the worker token; unset = the /api/worker routes answer 404.
WORKER_TOKEN_SHA256=
# Comma-separated names the safety filter treats as self references in AI answers.
WORKER_SELF_REFERENCE_TERMS=
# Budget of one run on the worker, per tier (ms, defaults 90000 / 240000). The end-to-end deadline of a
# request adds a queue allowance, so waiting behind another job does not eat into this budget.
WORKER_DEADLINE_LIGHT_MS=
WORKER_DEADLINE_COMPLEX_MS=

# Paths (relative paths are resolved against the process working directory)
# Default: ./client/dist or ../client/dist, whichever exists
CLIENT_DIST_DIR=
# Default: ./data
DATA_DIR=
# Directory containing fra.traineddata from tessdata_best (server OCR). Default: <DATA_DIR>/tessdata_best
# Download it with: npm run fetch-tessdata-best -w server
TESSDATA_BEST_DIR=
# Server OCR model: best_int (default, bundled npm model) | best (needs the downloaded model above)
OCR_SERVER_MODEL=

# Wiktionnaire lookups for the dictionary (true | false)
WIKTIONARY_ENABLED=true
# Operator contact appended to the Wiktionnaire User-Agent (e-mail or URL, recommended in production)
WIKIMEDIA_CONTACT=

# Number of reverse-proxy hops to trust (empty = disabled).
# Behind a reverse proxy this MUST be set (usually 1), otherwise every caller shares one rate-limit bucket.
TRUST_PROXY=
# Per-parent storage quota for uploaded originals and page images, in MB (default 2000)
UPLOAD_QUOTA_MB=

# Privacy policy (/confidentialite): who runs this server. Empty values appear as « à compléter » on the page,
# which must not happen in production: the App Store links to it.
LEGAL_OPERATOR=
LEGAL_CONTACT=
LEGAL_HOSTING=
# AI services the requests may reach, separated by ';' — e.g. OpenAI (États-Unis); Anthropic, Claude (États-Unis)
LEGAL_AI_PROVIDERS=
